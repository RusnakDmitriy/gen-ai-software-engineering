{
  "name": "customer-support-ticket-system",
  "version": "1.0.0",
  "description": "Intelligent customer support ticket management system with auto-classification",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test DATABASE_URL=file:./prisma/test.db LOG_LEVEL=silent vitest run",
    "test:cov": "NODE_ENV=test DATABASE_URL=file:./prisma/test.db LOG_LEVEL=silent vitest run --coverage",
    "test:unit": "NODE_ENV=test DATABASE_URL=file:./prisma/test.db LOG_LEVEL=silent vitest run tests/unit",
    "test:integration": "NODE_ENV=test DATABASE_URL=file:./prisma/test.db LOG_LEVEL=silent vitest run tests/integration",
    "test:perf": "NODE_ENV=test DATABASE_URL=file:./prisma/test.db LOG_LEVEL=silent vitest bench tests/performance",
    "test:watch": "NODE_ENV=test DATABASE_URL=file:./prisma/test.db LOG_LEVEL=silent vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:reset": "prisma migrate reset --force",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:dry-run": "tsx scripts/run-pipeline.ts --dry-run",
    "prepare": "husky install || true"
  },
  "keywords": [
    "support",
    "tickets",
    "classification",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/express": "^4.17.21",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^4.3.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.16.2",
    "pino-http": "^8.6.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.55.0",
    "@prettier/plugin-xml": "^3.2.2",
    "@types/cors": "^2.8.19",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/pino-http": "^5.8.4",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.55.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^1.1.0"
  }
}

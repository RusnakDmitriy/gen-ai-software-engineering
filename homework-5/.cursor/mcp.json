{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "envFile": "${workspaceFolder}/.env",
      "headers": {
        "Authorization": "Bearer ${env:GITHUB_PAT}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    "lorem-ipsum": {
      "command": "${workspaceFolder}/custom-mcp-server/.venv/bin/python",
      "args": [
        "${workspaceFolder}/custom-mcp-server/server.py"
      ]
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  }
}